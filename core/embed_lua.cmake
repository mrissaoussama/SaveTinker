# Writes ${OUTPUT} with core/lua/prelude.lua and every core/lua/modules/*.lua (as "st.<name>") embedded.
file(READ "${LUA_DIR}/prelude.lua" prelude)
set(body "#pragma once\n\n#include <string_view>\n#include <utility>\n\nnamespace st {\n\n")
string(APPEND body "inline constexpr std::string_view kPreludeSource = R\"st_lua(${prelude})st_lua\";\n\n")
string(APPEND body "inline constexpr std::pair<std::string_view, std::string_view> kBuiltinModules[] = {\n")
file(GLOB modules "${LUA_DIR}/modules/*.lua")
list(SORT modules)
foreach(module IN LISTS modules)
    get_filename_component(name "${module}" NAME_WE)
    file(READ "${module}" content)
    string(APPEND body "    {\"st.${name}\", R\"st_lua(${content})st_lua\"},\n")
endforeach()
string(APPEND body "};\n\n}\n")
file(WRITE "${OUTPUT}.tmp" "${body}")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
