; Dear ImGui vertices: position, texture coordinate and an 8-bit RGBA color.
.fvec projection[4]

.constf constants(1.0, 0.0, 0.00392156862, 0.0)
.alias ones constants.xxxx
.alias zeros constants.yyyy
.alias colorScale constants.zzzz

.out outPosition position
.out outTexcoord texcoord0
.out outColor color

.alias inPosition v0
.alias inTexcoord v1
.alias inColor v2

.proc main
    mov r0.xy, inPosition.xy
    mov r0.z, zeros
    mov r0.w, ones
    dp4 outPosition.x, projection[0], r0
    dp4 outPosition.y, projection[1], r0
    dp4 outPosition.z, projection[2], r0
    dp4 outPosition.w, projection[3], r0
    mov outTexcoord, inTexcoord
    mul outColor, colorScale, inColor
    end
.end
